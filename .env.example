# ─── Required ────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=change-me
SESSION_SECRET=change-me

# ─── Auth — root admin bootstrapped on first run ──────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
JWT_SECRET=change-me-in-production

# ─── API Key (optional) — for CI/CD service-to-service calls ─────────────────
# Set this to a strong random string, then use it as:
#   Authorization: Bearer <API_KEY>
# This bypasses cookie auth so pipelines don't need a login step.
# API_KEY=generate-a-strong-secret-here

# ─── Public URL (required for feedback links) ──────────────────────────────────
# The URL where your AgnusAI instance will be accessible from the internet.
# This is used for feedback links in PR comments and redirects.
# Examples: http://localhost:3000 or https://agnus.example.com
PUBLIC_URL=http://localhost:3000

# ─── LLM ─────────────────────────────────────────────────────────────────────
# Set LLM_PROVIDER to select your provider, then fill in the matching section.
# Supported: ollama | openai | azure | claude | custom

LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:397b-cloud
# Sampling temperature for agent generation calls (0.0–1.0).
# 0.2 = low variance while preserving non-obvious reasoning (recommended).
# 0   = fully deterministic but may miss indirect inferences.
# Judge and self-reflection calls are always forced to 0 regardless of this setting.
LLM_TEMPERATURE=0.2

# Option A: local Ollama (run `ollama serve` on your host)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Option B: OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-proj-...

# Option C: Azure OpenAI (supports both openai.azure.com and cognitiveservices.azure.com)
# LLM_PROVIDER=azure
# LLM_MODEL=gpt-4o-mini                         # deployment name
# AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/openai/deployments/gpt-4o-mini
# AZURE_OPENAI_API_KEY=...
# AZURE_API_VERSION=2025-01-01-preview           # optional, this is the default

# Option D: Anthropic / Claude
# LLM_PROVIDER=claude
# LLM_MODEL=claude-sonnet-4-6
# ANTHROPIC_API_KEY=sk-ant-...

# Option E: Any OpenAI-compatible endpoint (vLLM, LM Studio, Together, Groq, etc.)
# LLM_PROVIDER=custom
# LLM_MODEL=meta-llama/Llama-3-70b-instruct
# CUSTOM_LLM_URL=https://api.together.xyz/v1
# CUSTOM_LLM_API_KEY=...

# ─── Embeddings ───────────────────────────────────────────────────────────────
# Leave EMBEDDING_PROVIDER unset to disable embeddings (standard/fast review depth).
# Set it to enable deep mode (2-hop + semantic neighbor search via pgvector).

# Option A: local Ollama (run `ollama pull qwen3-embedding:0.6b` first)
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL=qwen3-embedding:0.6b    # 639MB, 40K ctx, #1 MTEB multilingual

# Option B: OpenAI
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small  # 1536-dim, $0.02/1M tokens
# EMBEDDING_API_KEY=sk-...

# Option C: Google (free tier: 1500 RPM)
# EMBEDDING_PROVIDER=google
# EMBEDDING_MODEL=text-embedding-004      # 768-dim
# EMBEDDING_API_KEY=AIza...

# Option D: Azure OpenAI embeddings (uses same AZURE_API_VERSION as LLM)
# EMBEDDING_PROVIDER=azure
# EMBEDDING_BASE_URL=https://your-resource.cognitiveservices.azure.com/openai/deployments/text-embedding-ada-002
# EMBEDDING_MODEL=text-embedding-ada-002
# EMBEDDING_API_KEY=...

# Option E: Any OpenAI-compatible endpoint (Cohere, Together, Voyage, etc.)
# EMBEDDING_PROVIDER=http
# EMBEDDING_BASE_URL=https://api.cohere.com/compatibility/v1
# EMBEDDING_MODEL=embed-v4.0
# EMBEDDING_API_KEY=...

# ─── Multi-agent review ───────────────────────────────────────────────────────
# Enable parallel specialist agents (security, correctness, performance, etc.)
# MULTI_AGENT_ENABLED=false

# Review mode when multi-agent is on: fast | thorough
# fast     — security + correctness agents only
# thorough — all agents (default when multi-agent is enabled)
# REVIEW_MODE=thorough

# Number of agents to run in parallel
# AGENT_CONCURRENCY=2

# Restrict which agents run (comma-separated). Leave unset to run all for the mode.
# ENABLED_AGENTS=security,correctness,performance,style_maintainability

# ─── Codebase exploration tools (agent tool-calling) ──────────────────────────
# Agents use read-only tools (get_symbol_body, find_callers, find_callees, read_file)
# to explore the codebase before writing findings. Requires repo to be indexed.
# Max tool-call rounds per agent (adaptive default: ≤3 files→3, 4–10→4, >10→5)
# AGENT_TOOL_MAX_ROUNDS=4

# Log every tool call and round for debugging
# TOOL_DEBUG=false

# Judge pass — collapses duplicate/low-signal findings across agents
# JUDGE_ENABLED=true

# Judge mode: llm | deterministic
# llm          — LLM semantically deduplicates and selects the best findings (default when MULTI_AGENT_ENABLED=true)
# deterministic — fast rule-based dedup by location only (no LLM call)
# JUDGE_MODE=llm

# Self-reflection second pass — second LLM call that re-scores each surviving comment
# 0-10 based on evidence quality; drops those below SELF_REFLECTION_THRESHOLD.
# Recommended when using multi-agent mode to reduce noise further.
# SELF_REFLECTION_ENABLED=false
# SELF_REFLECTION_THRESHOLD=6   # 5 = default, 6 = stricter (recommended with multi-agent)

# ─── Review depth ─────────────────────────────────────────────────────────────
# fast     — 1-hop graph traversal, no embeddings
# standard — 2-hop graph traversal, no embeddings (default, no Ollama needed)
# deep     — 2-hop + semantic neighbors via embedding search (requires EMBEDDING_PROVIDER)
REVIEW_DEPTH=standard

# ─── Precision filter ─────────────────────────────────────────────────────────
# Minimum LLM self-assessed confidence (0.0–1.0) for a comment to be posted.
# Raise to 0.75–0.8 to reduce low-confidence noise (default: 0.7)
# PRECISION_THRESHOLD=0.75

# ─── @ryv Command System ──────────────────────────────────────────────────────
# Bot mention name — users type @ryv <query> in PR comments to trigger NLP commands.
# RYV_BOT_NAME=ryv

# Set to false to disable @ryv command processing entirely (webhooks still run reviews).
# COMMANDS_ENABLED=true

# Max @ryv command calls per PR per hour (anti-abuse).
# COMMAND_MAX_PER_HOUR=10

# ─── VCS tokens ───────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_...
AZURE_DEVOPS_TOKEN=

# ─── OpenCode agentic executor ────────────────────────────────────────────────
# OpenCode runs as a sidecar service and executes agentic tasks
# (@ryv fix / @ryv generate test / @ryv implement).
# OPENCODE_URL=http://opencode:4096
# OPENCODE_SERVER_PASSWORD=
# LLM provider OpenCode uses for agentic tasks.
# Defaults to OpenCode's own free proxy (no credentials required).
# Available: opencode/big-pickle, opencode/gpt-5-nano, opencode/mimo-v2-flash-free
# Azure is not a built-in OpenCode provider; use the opencode proxy instead.
# OPENCODE_PROVIDER_ID=opencode
# OPENCODE_MODEL_ID=big-pickle

# ─── Traefik Gateway (advanced) ───────────────────────────────────────────────
# Enable Traefik dashboard (insecure, for debugging only)
# TRAEFIK_UI=false
# Traefik log level: DEBUG, INFO, WARN, ERROR, FATAL, PANIC
# TRAEFIK_LOG_LEVEL=INFO
